# TARGET database to analyze
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=querywise_demo
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=your_postgres_password

# APP database for QueryWise metadata
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=querywise_demo
APP_DB_USER=postgres
APP_DB_PASSWORD=your_postgres_password

# Slow query threshold
SLOW_QUERY_THRESHOLD_MS=500

# Frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# AI Explanation Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
